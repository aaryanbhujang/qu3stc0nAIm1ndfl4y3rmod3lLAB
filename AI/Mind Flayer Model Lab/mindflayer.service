[Unit]
Description=Mind Flayer Model Lab - CTF Challenge
After=network.target

[Service]
Type=exec
User=ctfuser
Group=ctfuser
WorkingDirectory=/opt/mindflayer/app
Environment=PATH=/opt/mindflayer/venv/bin
Environment=PORT=8000
Environment=FLASK_ENV=production
Environment=MAX_MODEL_MB=50
ExecStart=/opt/mindflayer/venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 120 app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target